{
  "name": "monsters-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:pages": "VITE_BASE=/monsters/ npm run build",
    "deploy": "bash tools/deploy_pages.sh",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "assets": "python3 tools/build_assets.py",
    "verify": "node tools/verify.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "playwright-core": "^1.56.0"
  }
}
